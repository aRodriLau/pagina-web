NODE_ENV=development
PORT=4000
# PostgreSQL con PostGIS
DATABASE_URL=postgresql://tappa:tappa@localhost:5432/tappa
REDIS_URL=redis://localhost:6379
# Genera con: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Storage S3 compatibile (MinIO in locale, Cloudflare R2 / AWS S3 in produzione)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=tappa-media
S3_ACCESS_KEY_ID=tappa
S3_SECRET_ACCESS_KEY=tappa-secret
S3_PUBLIC_URL=http://localhost:9000/tappa-media
